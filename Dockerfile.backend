FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/hf-cache

WORKDIR /app

# 1) Dependencies: heavy layer, rebuilt only when requirements.txt changes.
#    torch comes from the CPU-only index (the default wheel bundles CUDA).
COPY requirements.txt .
RUN pip install --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt

# 2) Models: heavy layer, baked into the image so the first request is fast
#    and the container works offline.
COPY scripts/download_models.py scripts/download_models.py
RUN python scripts/download_models.py

# 3) Application code: small layer, changes often.
COPY app/ app/

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/')"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
